MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=lis_production
MYSQL_USER=lis_app
MYSQL_PASSWORD=

# Secretos y valores compartidos entre servicios. Se inyectan desde acá a los
# contenedores que los necesitan (docker-compose.prod.yml -> environment), en
# vez de duplicarlos en el .env.prod de cada repo — mantenerlos sincronizados a
# mano en varios archivos es la causa #1 de fallas de auth entre servicios
# (guía de deploy §6.4).

# backend <-> clinical-matcher
LIS_MATCHER_INTERNAL_TOKEN=

# backend <-> rules-engine (va en los dos sentidos: el backend lo manda al
# engine, y el engine lo manda al backend para leer el catálogo de reglas)
LIS_RULES_ENGINE_INTERNAL_TOKEN=
LIS_RULES_ENGINE_TENANT_ID=lis-default

# Chat interno (lis-chat-service). Tiene base y usuario PROPIOS dentro de la
# misma instancia de MySQL del stack — no comparte la base del LIS. No hay que
# crearlos a mano: los crea scripts/create-chat-db.sh, que redeploy.sh llama en
# cada deploy. La contraseña sí hay que elegirla acá antes del primer deploy.
MYSQL_CHAT_DATABASE=lis_chat
MYSQL_CHAT_USER=lis_chat_user
MYSQL_CHAT_PASSWORD=

# Origen del navegador para el handshake de Socket.io y el CORS del chat: la
# URL con la que se entra al frontend. Vacío deja pasar cualquier origen.
LIS_CHAT_CORS_ORIGINS=https://<ip-del-server>:3000

# Integraciones con proveedores externos (lis-orchestrator + adapters).
# backend <-> orchestrator: el orchestrator lo manda como X-Internal-Token en
# los webhooks de integraciones (middleware internal.service:lis_orchestrator).
LIS_ORCHESTRATOR_INTERNAL_TOKEN=
# orchestrator <-> adapter de Labcore, y backend <-> adapter para la búsqueda
# sincrónica de pacientes de la admisión (se apaga con
# LIS_ADAPTER_LABCORE_PATIENT_LOOKUP=false).
LIS_ADAPTER_LABCORE_INTERNAL_TOKEN=
LIS_ADAPTER_LABCORE_PATIENT_LOOKUP=true
# Segundos que la admisión espera al adapter (adapter + Labcore API + SQL
# Server de Labcore) antes de seguir sólo con pacientes del LIS. Default 5.
# LIS_ADAPTER_LABCORE_TIMEOUT_SECONDS=5
# Ruteo a Labcore: habilitado, y opcionalmente acotado por códigos de origen
# y de servicio del LIS (separados por coma; vacío = todas las órdenes).
LABCORE_ENABLED=true
LABCORE_ORIGIN_CODES=
LABCORE_SERVICE_CODES=
# Labcore API: NO corre en este stack. Es un servicio de Windows en una máquina
# del cliente (el SQL Server de Labcore es 2008 R2 y no negocia con el driver
# de .NET desde Linux); el paquete se arma con
# scripts/build-labcore-api-windows.ps1. Base sin /api/v1. Obligatoria: sin
# ella el adapter no arranca. `stub` no llama a nadie (sólo para probar el
# circuito).
LABCORE_MODE=http
LABCORE_API_URL=http://<ip-windows-labcore-api>:5080
# Clave del adapter contra la Labcore API, 24+ caracteres al azar (sólo letras
# y números, así Compose no la rompe). La MISMA que se instaló en el servicio
# de Windows (Api:ApiKeys[0].Key, con CanWrite=true).
LABCORE_API_KEY=
# Fallback de los valores fijos que Labcore pide y el LIS no tiene; lo que se
# cargue en Admin > Integraciones > Labcore tiene prioridad. Vacío = no se manda.
LABCORE_PRIORITY_CODE_ROUTINE=
LABCORE_PRIORITY_CODE_URGENT=
LABCORE_PATIENT_TYPE_CODE=
