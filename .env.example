MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=lis_production
MYSQL_USER=lis_app
MYSQL_PASSWORD=

# Secretos y valores compartidos entre servicios. Se inyectan desde acá a los
# contenedores que los necesitan (docker-compose.prod.yml -> environment), en
# vez de duplicarlos en el .env.prod de cada repo — mantenerlos sincronizados a
# mano en varios archivos es la causa #1 de fallas de auth entre servicios
# (guía de deploy §6.4).

# backend <-> clinical-matcher
LIS_MATCHER_INTERNAL_TOKEN=

# backend <-> rules-engine (va en los dos sentidos: el backend lo manda al
# engine, y el engine lo manda al backend para leer el catálogo de reglas)
LIS_RULES_ENGINE_INTERNAL_TOKEN=
LIS_RULES_ENGINE_TENANT_ID=lis-default

# Chat interno (lis-chat-service). Tiene base y usuario PROPIOS dentro de la
# misma instancia de MySQL del stack — no comparte la base del LIS. No hay que
# crearlos a mano: los crea scripts/create-chat-db.sh, que redeploy.sh llama en
# cada deploy. La contraseña sí hay que elegirla acá antes del primer deploy.
MYSQL_CHAT_DATABASE=lis_chat
MYSQL_CHAT_USER=lis_chat_user
MYSQL_CHAT_PASSWORD=

# Origen del navegador para el handshake de Socket.io y el CORS del chat: la
# URL con la que se entra al frontend. Vacío deja pasar cualquier origen.
LIS_CHAT_CORS_ORIGINS=https://<ip-del-server>:3000

# Integraciones con proveedores externos (lis-orchestrator + adapters).
# backend <-> orchestrator: el orchestrator lo manda como X-Internal-Token en
# los webhooks de integraciones (middleware internal.service:lis_orchestrator).
LIS_ORCHESTRATOR_INTERNAL_TOKEN=
# orchestrator <-> adapter de Labcore, y backend <-> adapter para la búsqueda
# sincrónica de pacientes de la admisión (se apaga con
# LIS_ADAPTER_LABCORE_PATIENT_LOOKUP=false).
LIS_ADAPTER_LABCORE_INTERNAL_TOKEN=
LIS_ADAPTER_LABCORE_PATIENT_LOOKUP=true
# Segundos que la admisión espera al adapter (adapter + Labcore API + SQL
# Server de Labcore) antes de seguir sólo con pacientes del LIS. Default 5.
# LIS_ADAPTER_LABCORE_TIMEOUT_SECONDS=5
# Ruteo a Labcore: habilitado, y opcionalmente acotado por códigos de origen
# y de servicio del LIS (separados por coma; vacío = todas las órdenes).
LABCORE_ENABLED=true
LABCORE_ORIGIN_CODES=
LABCORE_SERVICE_CODES=
# Labcore API: NO corre en este stack. Es un servicio de Windows en una máquina
# del cliente (el SQL Server de Labcore es 2008 R2 y no negocia con el driver
# de .NET desde Linux); el paquete se arma con
# scripts/build-labcore-api-windows.ps1. Base sin /api/v1. Obligatoria: sin
# ella el adapter no arranca. `stub` no llama a nadie (sólo para probar el
# circuito).
LABCORE_MODE=http
LABCORE_API_URL=http://<ip-windows-labcore-api>:5080
# Clave del adapter contra la Labcore API, 24+ caracteres al azar (sólo letras
# y números, así Compose no la rompe). La MISMA que se instaló en el servicio
# de Windows (Api:ApiKeys[0].Key, con CanWrite=true).
LABCORE_API_KEY=
# Fallback de los valores fijos que Labcore pide y el LIS no tiene; lo que se
# cargue en Admin > Integraciones > Labcore tiene prioridad. Vacío = no se manda.
LABCORE_PRIORITY_CODE_ROUTINE=
LABCORE_PRIORITY_CODE_URGENT=
LABCORE_PATIENT_TYPE_CODE=

# Facturación electrónica ARCA (lis-arca-gateway). Stateless, single-tenant:
# un CUIT / punto de venta / certificado por deploy. Usa el Redis compartido
# del stack (namespaceado con prefijo `arca`), no hace falta configurar nada de
# Redis acá. El certificado y la clave privada NO van en el .env: se dejan en
# /opt/lis/secrets/arca (arca_cert.pem y arca_key.pem, chmod 600) y el compose
# los monta read-only.
# homologation = ambiente de testing de ARCA; production = real. Los WSDL de
# abajo tienen que ser los del MISMO ambiente.
ARCA_ENVIRONMENT=homologation
# CUIT del emisor, sin guiones. Obligatorio: sin él arca-gateway no arranca.
ARCA_CUIT=
# Punto de venta habilitado en ARCA para facturación electrónica. Obligatorio.
ARCA_POINT_OF_SALE=
# WSDL de WSAA (login/firma) y WSFEv1 (emisión). Los defaults del compose son
# los de HOMOLOGACIÓN; para producción descomentar y usar los de wsaa/wsfe
# productivos:
#   ARCA_WSAA_WSDL=https://wsaa.afip.gov.ar/ws/services/LoginCms?wsdl
#   ARCA_WSFE_WSDL=https://servicios1.afip.gov.ar/wsfev1/service.asmx?WSDL
# ARCA_WSAA_WSDL=
# ARCA_WSFE_WSDL=
# backend <-> arca-gateway. Mismo valor a los dos lados (header
# X-Internal-Token). Vacío deja el gateway abierto a cualquiera que esté en la
# red de Docker: ponerle algo.
LIS_ARCA_GATEWAY_INTERNAL_TOKEN=
# Segundos que la caja espera al gateway. Adentro hay dos round-trips SOAP
# contra ARCA, por eso es tan largo. Default 45.
# LIS_ARCA_GATEWAY_TIMEOUT_SECONDS=45
# Quién autoriza los comprobantes que emite la caja: `mock` inventa el CAE (no
# toca el gateway: sirve para probar el circuito sin certificado) y `arca` se
# lo pide a ARCA de verdad. El CUIT y el punto de venta del backend salen de
# ARCA_CUIT / ARCA_POINT_OF_SALE de arriba, para que no se desincronicen con
# los del gateway. Los datos del emisor que salen IMPRESOS en el comprobante
# (BILLING_ISSUER_*) van en el .env.prod del backend, no acá.
BILLING_AUTHORITY=mock

# Servicio de documentos (lis-reporting-service, repo lis-reports-engine). Es
# el que dibuja lo que el LIS imprime: hoy el ticket fiscal de la caja. No
# guarda nada y sólo lo llama el backend.
# Obligatorio: en producción el servicio NO arranca sin token, y es el mismo
# valor que manda el backend como X-Internal-Token.
LIS_REPORTING_SERVICE_INTERNAL_TOKEN=
# Segundos que el backend espera el documento. El primero de la mañana tiene
# que esperar a que arranque Chromium. Default 20.
# LIS_REPORTING_SERVICE_TIMEOUT_SECONDS=20
# De dónde salen los templates. `local` usa los que vienen EN la imagen, que
# es donde vive hoy el ticket de CEBAC: no hace falta S3 ni credenciales.
# Pasar a `s3` sólo cuando los templates se publiquen en el bucket; ahí hay que
# agregar además AWS_REGION / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY al
# `environment` de reporting-service en el compose (vacías no sirven: el
# servicio no arranca si están y están en blanco).
# TEMPLATE_SOURCE=local
# Allowlist de buckets y prefijos de templates. Se valida INCLUSO en modo
# local, así que el bucket que manda el backend
# (BILLING_DOCUMENT_TEMPLATE_BUCKET, default lis-report-templates) tiene que
# estar acá.
# ALLOWED_TEMPLATE_BUCKETS=lis-report-templates
# ALLOWED_TEMPLATE_PREFIXES=customers

# Mensajería a los pacientes (lis-messaging-service): email por SES y WhatsApp
# por la Cloud API de Meta. Base y usuario PROPIOS en la misma instancia de
# MySQL, como el chat: los crea scripts/create-messaging-db.sh en cada deploy;
# la contraseña hay que elegirla acá antes del primer deploy.
MYSQL_MESSAGING_DATABASE=lis_messaging
MYSQL_MESSAGING_USER=lis_messaging_user
MYSQL_MESSAGING_PASSWORD=
# backend <-> messaging-service. Obligatorio: el servicio no arranca sin él.
LIS_MESSAGING_SERVICE_INTERNAL_TOKEN=
# Segundos que el backend espera el primer intento de un envío. Default 15.
# LIS_MESSAGING_SERVICE_TIMEOUT_SECONDS=15
# El remitente de los mails. Obligatorio; con SES, una identidad verificada.
MESSAGING_EMAIL_FROM=
MESSAGING_EMAIL_FROM_NAME=CEBAC
# MESSAGING_EMAIL_REPLY_TO=
# `log` deja cada mail como .eml en el volumen messaging-storage y no manda
# nada; `ses` los manda de verdad.
MESSAGING_EMAIL_DRIVER=log
# Región de SES y de las colas SQS, y las credenciales del usuario IAM con la
# policy que crea el stack de lis-messaging-service/aws (outputs ServicePolicyArn).
MESSAGING_AWS_REGION=us-east-1
MESSAGING_AWS_ACCESS_KEY_ID=
MESSAGING_AWS_SECRET_ACCESS_KEY=
# Outputs del stack de aws/: el configuration set de SES y las dos colas de
# avisos. Vacías, los mensajes se quedan en `sent` (no se sabe si llegaron).
MESSAGING_SES_CONFIGURATION_SET=
MESSAGING_SQS_EMAIL_EVENTS_URL=
MESSAGING_SQS_WHATSAPP_EVENTS_URL=
# WhatsApp: apagado hasta tener el número de LIS, un token de usuario de
# sistema y las plantillas aprobadas en Meta. `cloud` manda de verdad.
MESSAGING_WHATSAPP_ENABLED=false
MESSAGING_WHATSAPP_DRIVER=log
MESSAGING_WHATSAPP_PHONE_NUMBER_ID=
MESSAGING_WHATSAPP_ACCESS_TOKEN=
# Lo que se le contesta a un paciente que escribe al número (una vez por día).
# MESSAGING_WHATSAPP_AUTO_REPLY=
# Avisos automáticos al paciente. MESSAGING_EVENTS_ENABLED prende las dos
# puntas: el backend publica en lis:events:messaging y el servicio lo lee.
# MESSAGING_AUTO_COMMUNICATIONS elige cuáles (order.created,
# samples.collected); vacío no manda ninguno aunque los eventos corran.
MESSAGING_EVENTS_ENABLED=false
MESSAGING_AUTO_COMMUNICATIONS=
# Orden de preferencia: WhatsApp sólo con celular y consentimiento del
# paciente; si no se puede, el siguiente.
# MESSAGING_AUTO_CHANNELS=whatsapp,email


# Llamador de turnos: Reverb, el WebSocket que avisa a los displays cada vez
# que se llama un turno. El backend publica por la red de Docker y los
# navegadores escuchan por nginx en el 6001 (con el mismo certificado que el
# resto). Las tres son obligatorias; KEY y SECRET, cadenas al azar
# (p. ej. `openssl rand -hex 16`). La KEY es pública: va en el build del
# display. El SECRET no sale nunca del servidor.
REVERB_APP_ID=lis-cebac
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Desde qué hosts se puede abrir el socket (sin esquema ni puerto), separados
# por coma: el del LIS, que sirve también el display y el tótem.
REVERB_ALLOWED_ORIGINS=192.168.4.95
# Dónde ve el navegador a Reverb. Vacío = el mismo host del LIS, que es lo
# normal; sólo hace falta si Reverb queda en otro host.
# REVERB_PUBLIC_HOST=
# REVERB_PUBLIC_PORT=6001
